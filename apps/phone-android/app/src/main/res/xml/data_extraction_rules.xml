<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: the token ciphertext is useless without this device's Keystore key,
     and settings are quick to re-enter. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
